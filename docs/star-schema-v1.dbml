// Star Schema v1 - Penjualan Reseller - Kelompok X
// Tempel isi file ini di https://dbdiagram.io untuk melihat dan mengedit diagram.
// Tipe data masih perkiraan. Tipe final ditetapkan di desain fisik (pekan 11).

Table fact_penjualan_reseller [note: 'Grain: satu baris per baris pesanan reseller (sales_salesorderdetail, OnlineOrderFlag = 0)'] {
  tanggal_pesan_key       int [ref: > dim_tanggal.tanggal_key]
  tanggal_jatuh_tempo_key int [ref: > dim_tanggal.tanggal_key]
  tanggal_kirim_key       int [ref: > dim_tanggal.tanggal_key]
  produk_key              int [ref: > dim_produk.produk_key]
  reseller_key            int [ref: > dim_reseller.reseller_key]
  sales_person_key        int [ref: > dim_sales_person.sales_person_key]
  wilayah_key             int [ref: > dim_wilayah.wilayah_key]
  promosi_key             int [ref: > dim_promosi.promosi_key]
  mata_uang_key           int [ref: > dim_mata_uang.mata_uang_key]
  metode_key              int [ref: > dim_metode_kirim.metode_key]
  nomor_pesanan           varchar(25) [note: 'degenerate dimension: SalesOrderNumber']
  nomor_baris_pesanan     int         [note: 'degenerate dimension: SalesOrderDetailID']
  nomor_po_reseller       varchar(25) [note: 'degenerate dimension: PurchaseOrderNumber']
  jumlah_unit             int           [note: 'aditif']
  nilai_penjualan         decimal(19,4) [note: 'aditif, USD']
  nilai_diskon            decimal(19,4) [note: 'aditif, USD']
  total_biaya_produk      decimal(19,4) [note: 'aditif, USD, biaya standar historis']
  harga_satuan            decimal(19,4) [note: 'non-aditif, tampilkan sebagai rata-rata']

  indexes {
    (nomor_pesanan, nomor_baris_pesanan) [unique]
  }
}

Table dim_tanggal [note: 'Conformed. Struktur standar dari sponsor (pekan 10)'] {
  tanggal_key int [pk, note: 'format YYYYMMDD']
  tanggal     date
  hari        varchar(10)
  bulan       smallint
  nama_bulan  varchar(10)
  kuartal     smallint
  tahun       smallint
}

Table dim_produk [note: 'Conformed. Struktur final disepakati kelas di pekan 10'] {
  produk_key   int [pk]
  produk_id    int [note: 'production_product.ProductID']
  nomor_produk varchar(25)
  nama_produk  varchar(50)
  warna        varchar(15)
  ukuran       varchar(5)
  garis_produk varchar(20)
  model        varchar(50)
  subkategori  varchar(50)
  kategori     varchar(50)
  harga_list   decimal(19,4)
  status_jual  varchar(20)
}

Table dim_reseller [note: 'Khusus proses reseller. Sumber: sales_store + alamat Main Office + XML di kolom Demographics'] {
  reseller_key    int [pk]
  reseller_id     int [note: 'sales_store.BusinessEntityID']
  nama_reseller   varchar(50)
  tipe_bisnis     varchar(30)
  spesialisasi    varchar(30)
  tahun_buka      smallint
  jumlah_karyawan int
  kota            varchar(30)
  provinsi        varchar(50)
  negara          varchar(50)
}

Table dim_sales_person [note: 'Conformed dengan proses Kinerja Sales. Kandidat SCD tipe 2 untuk wilayah_tugas'] {
  sales_person_key  int [pk]
  sales_person_id   int [note: 'sales_salesperson.BusinessEntityID']
  nama_sales_person varchar(100)
  jabatan           varchar(50)
  wilayah_tugas     varchar(50)
  persen_komisi     decimal(10,4)
}

Table dim_wilayah [note: 'Conformed'] {
  wilayah_key  int [pk]
  wilayah_id   int [note: 'sales_salesterritory.TerritoryID']
  nama_wilayah varchar(50)
  kode_negara  varchar(3)
  nama_negara  varchar(50)
  grup_wilayah varchar(50)
}

Table dim_promosi [note: 'Conformed dengan Penjualan Online'] {
  promosi_key      int [pk]
  promosi_id       int [note: 'sales_specialoffer.SpecialOfferID']
  nama_promosi     varchar(255)
  jenis_promosi    varchar(50)
  kategori_promosi varchar(50)
  persen_diskon    decimal(10,4)
  tanggal_mulai    date
  tanggal_selesai  date
  qty_min          int
  qty_maks         int
}

Table dim_mata_uang [note: 'Conformed dengan Penjualan Online'] {
  mata_uang_key  int [pk]
  kode_mata_uang char(3)
  nama_mata_uang varchar(50)
}

Table dim_metode_kirim [note: 'Conformed'] {
  metode_key   int [pk]
  metode_id    int [note: 'purchasing_shipmethod.ShipMethodID']
  nama_metode  varchar(50)
  tarif_dasar  decimal(19,4)
  tarif_per_kg decimal(19,4)
}
